# ============================================================
#  文件码爬虫系统 — 环境变量配置
#  使用方式: 复制此文件为 .env 并填入真实值
#  功能：自动发现、抓取、解析 Telegram 第三方文件码并缓存
# ============================================================

# -------------------------------------------------------
#  Telegram API 凭证（必需，从 https://my.telegram.org/apps 获取）
# -------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+8612345678900

# -------------------------------------------------------
#  爬取配置
# -------------------------------------------------------
# 爬取间隔（分钟）
CRAWL_INTERVAL_MINUTES=30
# 每个频道最多扫描的消息数
CRAWL_MESSAGE_LIMIT_PER_CHANNEL=200
# 并发爬取频道数
MAX_CONCURRENT_CRAWLS=3

# -------------------------------------------------------
#  解析器配置
# -------------------------------------------------------
# 向外部机器人发送码后，等待响应的超时时间（秒）
RESOLVE_TIMEOUT_SECONDS=30
# 每批解析的文件码数量
RESOLVE_BATCH_SIZE=5
# 持续解析模式下，每轮之间的间隔（秒）
RESOLVE_INTERVAL_SECONDS=10
# 每个码的最大解析重试次数
RESOLVE_MAX_RETRIES=3
# 解析每个码之间的延迟（秒），避免触发外部机器人的频率限制
RESOLVE_DELAY_BETWEEN_CODES=3.0
# 翻页总超时时间（秒），翻页不限页数，超过该时间强制终止。设 0 则完全无限制
RESOLVE_PAGINATION_TIMEOUT=600

# -------------------------------------------------------
#  全自动守护模式配置
# -------------------------------------------------------
# 每轮是否先执行爬取（True=先爬再解析，False=只解析）
DAEMON_CRAWL_FIRST=true
# 全自动模式轮询间隔（秒）
DAEMON_CYCLE_INTERVAL=60

# -------------------------------------------------------
#  主系统 Bot 用户名（与主系统通信）
# -------------------------------------------------------
UPLOAD_BOT_USERNAME=upload_bot_username
DECODER_BOT_USERNAME=decoder_bot_username
SENDER_BOT_USERNAME=sender_bot_username

# -------------------------------------------------------
#  文件码前缀（与主系统一致）
# -------------------------------------------------------
FILE_CODE_PREFIX=tgwenjian

# -------------------------------------------------------
#  本地存储
# -------------------------------------------------------
# SQLite 数据库路径（默认 codes.db）
SQLITE_DB_PATH=codes.db
# 导出目录
EXPORT_DIR=exports

# -------------------------------------------------------
#  日志级别: DEBUG, INFO, WARNING, ERROR
# -------------------------------------------------------
LOG_LEVEL=INFO

# -------------------------------------------------------
#  管理员 Bot 配置（独立 Bot Token）
#  在 @BotFather 创建 Bot 后获取 Token
#  覆盖规则存储在本地 SQLite，无需额外部署
# -------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# 授权用户 ID 列表（逗号分隔），这些用户可向 Bot 发送管理指令
ADMIN_USER_IDS=[]
