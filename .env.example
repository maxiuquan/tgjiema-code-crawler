# Telegram API 凭证（必需，从 https://my.telegram.org/apps 获取）
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+8612345678900

# 爬取间隔（分钟）
CRAWL_INTERVAL_MINUTES=30

# 每个频道最多扫描的消息数
CRAWL_MESSAGE_LIMIT_PER_CHANNEL=200

# 搜索关键词（逗号分隔）
SEARCH_KEYWORDS=文件码,file code,解码,文件分享,资源共享,网盘,bot

# 搜索数量限制
SEARCH_LIMIT=50

# 并发爬取频道数
MAX_CONCURRENT_CRAWLS=3

# ========== 存储频道（必需，用于预缓存外部机器人的文件）==========
# 主系统的存储频道 ID，爬虫解析外部文件后会复制到此频道
STORAGE_CHANNEL_ID=-1001234567890

# ========== CockroachDB（推荐，用于将文件记录写入主数据库）==========
# 配置后，解析成功的文件会自动写入 file_records 和 code_bot_mapping 表
COCKROACHDB_URL=postgresql://user:pass@host:26257/dbname?sslmode=disable

# ========== 文件码解析器配置 ==========
# 向外部机器人发送码后，等待响应的超时时间（秒）
RESOLVE_TIMEOUT_SECONDS=30
# 每批解析的文件码数量
RESOLVE_BATCH_SIZE=5
# 持续解析模式下，每轮之间的间隔（秒）
RESOLVE_INTERVAL_SECONDS=10
# 每个码的最大解析重试次数
RESOLVE_MAX_RETRIES=3
# 解析每个码之间的延迟（秒），避免触发外部机器人的频率限制
RESOLVE_DELAY_BETWEEN_CODES=3.0

# ========== 全自动守护模式配置 ==========
# 每轮是否先执行爬取（True=先爬再解析，False=只解析）
DAEMON_CRAWL_FIRST=true
# 全自动模式轮询间隔（秒）
DAEMON_CYCLE_INTERVAL=60

# SQLite 数据库路径（默认 codes.db）
SQLITE_DB_PATH=codes.db

# 导出目录
EXPORT_DIR=exports

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO